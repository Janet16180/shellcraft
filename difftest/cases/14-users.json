  {"name": "chown gives nothing away", "world": "guild", "lines": ["cd hall", "chown hero:scribes mine.txt && ls -l mine.txt", "chown :hero mine.txt; chown hero mine.txt; chown 1000 mine.txt; chown : mine.txt; ls -l mine.txt", "chown 1000:1002 mine.txt; chown hero: mine.txt; ls -l mine.txt", "chown mira mine.txt", "chown hero miras.txt", "chown :scribes miras.txt", "chown hero:9999 mine.txt", "chown : miras.txt", "chown root /etc/passwd", "chown nosuch mine.txt", "chown nosuch:hero mine.txt", "chown hero:nosuch mine.txt", "chown :nosuch mine.txt", "chown nosuch: mine.txt", "chown -R", "chown hero", "chown hero.scribes mine.txt; ls -l mine.txt", "chown -v .hero mine.txt"]},
  {"name": "chown and chgrp -v, -c and -R", "world": "guild", "lines": ["cd hall", "chown -v hero:scribes mine.txt", "chown -c :hero mine.txt", "chown -v hero mine.txt; chown -v hero: mine.txt; chown -v : mine.txt; chown -c hero: mine.txt", "chown -v 1000:1002 mine.txt", "chown -v mira mine.txt", "chown -f mira mine.txt", "mkdir -p d/e && touch d/e/z && chgrp -Rv scribes d", "chown -R mira d", "chgrp -R scribes ronly", "chgrp -R scribes sealed && ls -ld sealed"]},
